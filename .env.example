# Copy to .env (git-ignored) for the Python scripts, and to web/.env.local for the web app. Never commit real values.
SNOWFLAKE_ACCOUNT=<org>-<account>
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
CORTEX_MODEL=llama3.3-70b

# Only for neopapyrus_cli.py (Cortex REST API). PAT auth needs a network policy on the account.
SNOWFLAKE_ACCOUNT_URL=https://<org>-<account>.snowflakecomputing.com
SNOWFLAKE_PAT=
